    "/tickets/{ticket_id}/advance": {
      "post": {
        "description": "Manual override \u2014 manager/kitchen only (SPEC.md \u00a73.3).\n\nBoard calling this directly with a staff token is a Phase 8 concern (see\n`kitchen.auth`'s module docstring); until then it's reached only through\nfront-of-house's own service token, scoped to `kitchen:advance`.",
        "operationId": "advance_ticket_manually_tickets__ticket_id__advance_post",
        "parameters": [
          {
            "in": "path",
            "name": "ticket_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Ticket Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
