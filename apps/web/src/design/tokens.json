    "status-baking": { "dark": "#FF6B35", "light": "#D14808" },
    "status-boxed": { "dark": "#FFB03A", "light": "#96650A" },
    "status-ready": { "dark": "#3DD68C", "light": "#0B7A4B" },
    "status-assigned": { "dark": "#4FC3F7", "light": "#0C7BB5" },
    "status-picked-up": { "dark": "#29B6F6", "light": "#0A6E9E" },
