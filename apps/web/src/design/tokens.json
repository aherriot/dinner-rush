    "status-delivered": { "dark": "#5FA97F", "light": "#3D7A57" },
    "status-rejected": { "dark": "#B47CE6", "light": "#7B3FB8" },
    "status-failed": { "dark": "#F2545B", "light": "#C41E3A" },
    "status-late": { "dark": "#FFB03A", "light": "#96650A" },

    "oven-free": { "dark": "#2E3644", "light": "#C8D0DE" },
    "oven-reserved": { "dark": "#D9A441", "light": "#9A6B10" },
    "oven-occupied": { "dark": "#FF6B35", "light": "#D14808" },
    "oven-down": { "dark": "#F2545B", "light": "#C41E3A" },
    "courier-idle": { "dark": "#78828F", "light": "#7B8496" },
    "courier-active": { "dark": "#4FC3F7", "light": "#0C7BB5" },
    "courier-offline": { "dark": "#78828F", "light": "#7B8496" },

    "accent": { "dark": "#FF8A3D", "light": "#B04E0C" },
    "accent-hover": { "dark": "#FFA05C", "light": "#C25A10" },
    "accent-active": { "dark": "#E5762B", "light": "#9A430A" }
  },

  "contrastRatio": {
    "text-primary": { "dark": 14.87, "light": 18.43 },
    "text-secondary": { "dark": 7.29, "light": 7.53 },
    "text-tertiary": { "dark": 4.74, "light": 4.59 },
    "status-placed": { "dark": 6.15, "light": 5.64 },
    "status-accepted": { "dark": 6.30, "light": 5.10 },
    "status-queued": { "dark": 7.97, "light": 4.68 },
    "status-prepping": { "dark": 7.03, "light": 4.66 },
    "status-baking": { "dark": 6.32, "light": 4.52 },
    "status-boxed": { "dark": 9.84, "light": 5.04 },
    "status-ready": { "dark": 9.56, "light": 5.39 },
    "status-assigned": { "dark": 8.95, "light": 4.65 },
    "status-picked-up": { "dark": 7.78, "light": 5.62 },
    "status-delivering": { "dark": 6.33, "light": 6.88 },
    "status-delivered": { "dark": 6.38, "light": 5.10 },
    "status-rejected": { "dark": 5.95, "light": 6.47 },
    "status-failed": { "dark": 5.29, "light": 5.84 },
    "accent": { "dark": 7.65, "light": 5.33 }
  },

  "typography": {
    "fontUi": "'Inter var', system-ui, sans-serif",
    "fontMono": "'JetBrains Mono', ui-monospace, monospace",
    "scale": {
      "caption": { "size": "11px", "line": "1.35", "weight": "500" },
      "sm": { "size": "12px", "line": "1.40", "weight": "400" },
      "body": { "size": "13px", "line": "1.45", "weight": "400" },
      "lg": { "size": "15px", "line": "1.45", "weight": "400" },
      "h3": { "size": "18px", "line": "1.30", "weight": "600" },
      "h2": { "size": "24px", "line": "1.25", "weight": "600" },
      "h1": { "size": "32px", "line": "1.20", "weight": "700" },
      "metric-sm": { "size": "20px", "line": "1.10", "weight": "600" },
      "metric": { "size": "28px", "line": "1.05", "weight": "600" },
      "metric-lg": { "size": "40px", "line": "1.00", "weight": "700" }
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "caption": "0.02em",
      "normal": "0"
    }
  },

  "space": {
    "row-dense": "28px",
    "row-default": "32px",
    "control-sm": "24px",
    "control": "32px",
    "panel-gutter": "12px",
    "panel-gap": "8px"
  },

  "radius": {
    "sm": "2px",
    "default": "4px",
    "lg": "6px",
    "pill": "999px"
  },

  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "normal": "220ms",
      "slow": "400ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inout": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },

  "statusMeta": {
    "placed": { "glyph": "○", "label": "Placed", "motion": "enter 140ms" },
    "accepted": { "glyph": "●", "label": "Accepted", "motion": null },
    "queued": { "glyph": "▢", "label": "Queued", "motion": null },
    "prepping": { "glyph": "◐", "label": "Prepping", "motion": null },
    "baking": { "glyph": "◕", "label": "Baking", "motion": "progress fill" },
    "boxed": { "glyph": "▣", "label": "Boxed", "motion": null },
    "ready": { "glyph": "★", "label": "Ready", "motion": "pulse 1.2s ×3" },
    "assigned": { "glyph": "◇", "label": "Assigned", "motion": null },
    "picked_up": { "glyph": "◆", "label": "Picked up", "motion": null },
    "delivering": { "glyph": "▸", "label": "Delivering", "motion": null },
    "delivered": { "glyph": "✓", "label": "Delivered", "motion": "recede 220ms" },
    "rejected": { "glyph": "⊘", "label": "Rejected", "motion": "enter 80ms, no ease" },
    "failed": { "glyph": "✕", "label": "Failed", "motion": null }
  }
}
