{
  "$schema": "Authored by hand per DESIGN.md. Do not edit tokens.css/tokens.ts/tokens.storybook.ts directly — they are generated by `pnpm tokens:build`.",

  "primitive": {
    "space": {
      "0": "0px",
      "1": "2px",
      "2": "4px",
      "3": "6px",
      "4": "8px",
      "5": "12px",
      "6": "16px",
      "7": "20px",
      "8": "24px",
      "9": "32px",
      "10": "48px",
      "11": "64px"
    }
  },

  "color": {
    "bg-base": { "dark": "#0B0E14", "light": "#F4F6FA" },
    "bg-panel": { "dark": "#131720", "light": "#FFFFFF" },
    "bg-raised": { "dark": "#1A2029", "light": "#FFFFFF" },
    "bg-inset": { "dark": "#080A0F", "light": "#EAEEF5" },
