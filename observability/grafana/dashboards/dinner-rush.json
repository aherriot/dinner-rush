{
  "uid": "dinner-rush",
  "title": "Dinner Rush",
  "description": "SPEC.md §7's metric table, live. stream_pending and promise_error_seconds are the two that make the backpressure/degradation claims falsifiable (ADR 0009).",
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Orders placed, by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(orders_placed_total[1m]))",
          "legendFormat": "{{outcome}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejection reasons",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(order_rejections_total[1m]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Kitchen queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "max(), not a bare metric name: a pull-based gauge like this reads the same Postgres state regardless of which process reports it, so collapsing on the reporting instance is defensive even though only one process (kitchen's main.py) registers it.",
      "targets": [
        {
          "expr": "max(kitchen_queue_depth)",
          "legendFormat": "queue depth",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Oven slots: occupied / total",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (state) (oven_slots_occupied{state=\"occupied\"})",
          "legendFormat": "occupied",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "max by (state) (oven_slots_occupied{state=\"total\"})",
          "legendFormat": "total",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "stream_pending — the backlog a chaos demo drains",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Watch group=cg:dispatch climb during `docker compose stop dispatch` and drain on restart (PHASES.md Phase 10).",
      "targets": [
        {
          "expr": "max by (group, stream) (stream_pending)",
          "legendFormat": "{{group}} / {{stream}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Promise accuracy — promise_error_seconds (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(promise_error_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(promise_error_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Actual bake time — order_cook_seconds (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(order_cook_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_cook_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Slot claim contention",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Claim attempts that lost the SKIP LOCKED race or found the oven genuinely full (DECISIONS.md §0002). sum(), not a bare rate(): kitchen-celery-worker's prefork pool is several OS processes, each holding a genuine partial count, not a duplicate of the same total — this needs summing to be correct, not just to collapse duplicate lines.",
      "targets": [
        {
          "expr": "sum(rate(slot_claim_contention_total[1m]))",
          "legendFormat": "contention/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}
